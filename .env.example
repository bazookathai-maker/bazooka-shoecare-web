# WooCommerce REST API v3 (order create)
# Point at the WordPress host that actually serves /wp-json (NOT Vercel 403).
# Example: https://your-wordpress-host.com/wp-json/wc/v3
VITE_WC_REST_URL=

# Optional: host only for Vite DEV proxy /wc-rest (defaults from VITE_WC_REST_URL or bazookashoecare.com)
# VITE_WC_REST_PROXY_TARGET=https://your-wordpress-host.com

# Create under WooCommerce → Settings → Advanced → REST API
# Use Read/Write (or create-orders capable) keys. These VITE_ vars are exposed to the browser.
VITE_WC_CONSUMER_KEY=
VITE_WC_CONSUMER_SECRET=

# Optional Store API override (cart/products)
# VITE_WC_STORE_API_URL=
