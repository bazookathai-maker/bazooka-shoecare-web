# Server-only WooCommerce REST credentials (Vercel / local Vite DEV).
# NEVER use VITE_ prefix for these — they must not ship to the browser.
# On Vercel: Project Settings → Environment Variables
# Locally: copy to .env (gitignored)
WOOCOMMERCE_URL=https://your-wordpress-host.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Optional Store API override for cart/products (public endpoint; OK as VITE_)
# VITE_WC_STORE_API_URL=
