# Server-only WooCommerce credentials (Vercel / local Vite DEV).
# NEVER use VITE_ prefix for these — they must not ship to the browser.
# On Vercel: Project Settings → Environment Variables (Production + Preview)
# Locally: copy to .env (gitignored). Sensitive Vercel vars cannot be pulled via CLI.
#
# Products API prefers REST when KEY/SECRET look valid (ck_/cs_);
# otherwise it falls back to public Store API on WOOCOMMERCE_URL (read-only catalog).
# create-order always requires real KEY + SECRET.
WOOCOMMERCE_URL=https://your-wordpress-host.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Omise PromptPay Test Mode (server-only — NEVER use VITE_ prefix)
# Value must be a test secret (skey_test_...). Do not commit real keys.
OMISE_SECRET_KEY=

# Optional Store API override for cart/products session (public endpoint; OK as VITE_)
# VITE_WC_STORE_API_URL=
