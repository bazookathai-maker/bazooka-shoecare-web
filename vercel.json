{
  "redirects": [
    {
      "source": "/articles/storage-odor-prevent",
      "destination": "/articles/studs-clean",
      "statusCode": 301
    },
    {
      "source": "/articles/storage-odor-prevent/",
      "destination": "/articles/studs-clean",
      "statusCode": 301
    },
    {
      "source": "/articles/rain-wet-clean",
      "destination": "/articles/on-cloud-clean",
      "statusCode": 301
    },
    {
      "source": "/articles/rain-wet-clean/",
      "destination": "/articles/on-cloud-clean",
      "statusCode": 301
    },
    {
      "source": "/articles/white-sneaker-restore",
      "destination": "/articles/running-shoe-clean",
      "statusCode": 301
    },
    {
      "source": "/articles/white-sneaker-restore/",
      "destination": "/articles/running-shoe-clean",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/en",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/en/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/en/(account|cart|checkout|order-success|track-order|login|register|featured-products)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/en/order-status/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(account|cart|checkout|order-success|track-order|login|register|featured-products|app.html)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/order-status/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/create-stripe-checkout",
      "destination": "/api/payments/stripe-checkout"
    },
    {
      "source": "/api/create-promptpay",
      "destination": "/api/payments/promptpay"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/webhooks/stripe"
    },
    {
      "source": "/api/omise-webhook",
      "destination": "/api/webhooks/omise"
    },
    {
      "source": "/api/cart",
      "destination": "/api/cart-proxy"
    },
    {
      "source": "/api/cart/:path*",
      "destination": "/api/cart-proxy?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ]
}
